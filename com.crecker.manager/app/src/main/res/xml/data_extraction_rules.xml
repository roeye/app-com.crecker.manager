<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12+. See backup_rules.xml for why settings are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="mail-cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="mail-cache/" />
    </device-transfer>
</data-extraction-rules>
