<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower.
   Settings live in DataStore and include an encrypted password. The encryption key lives in the
   Android Keystore and is never backed up, so a restored copy could not be decrypted anyway.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
